{
 "fidelity": "L3 controlled variant (common encoder-classifier interface)",
 "data": {
  "regime": "sysB",
  "train_limit": null,
  "valid_limit": 2000
 },
 "optim": {
  "type": "adamw",
  "lr": 0.001,
  "betas": [
   0.9,
   0.98
  ],
  "eps": 1e-08,
  "weight_decay": 0.01,
  "schedule": "cosine",
  "warmup_steps": 300,
  "clip_norm": 1.0
 },
 "loss": {
