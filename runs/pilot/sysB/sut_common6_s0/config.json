    "attn_expert_dim": 64,
    "ff_num_expert": 4,
    "ff_k": 2,
    "ff_expert_dim": 256,
    "miloss": 0.1
   },
   "share_layers": true,
   "halting": true
  }
 },
 "name": "sut_common6",
 "family": "SUT"
}