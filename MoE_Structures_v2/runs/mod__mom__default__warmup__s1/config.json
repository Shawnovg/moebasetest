{
 "backbone": {
  "activation": "gelu",
  "d_ff": 512,
  "d_model": 128,
  "head_dim": 32,
  "ln_eps": 1e-05,
  "max_len": 512,
  "n_heads": 4,
  "n_layers": 2,
  "rope_base": 10000.0
 },
 "dataset": "mod",
 "routing": {
  "balance": "warmup",
  "warmup_frac": 0.1
 },
 "structure": "mom",
 "structure_params": {
  "aux_coef": 0.01,
  "depth": 2,
  "enable_pause": true,
  "k": 1,
  "num_attn": 4,
  "num_ffn": 4,
  "router_dim": 256,
  "router_type": "naive"
 },
 "train": {
  "batch_size": 64,
  "betas": [
   0.9,
   0.98
  ],
  "eval_batches": 8,
  "eval_every": 500,
  "grad_clip": 1.0,
  "lr": 0.001,
  "schedule": "cosine",
  "seed": 1,
  "steps": 3000,
  "threads": 1,
  "warmup_steps": 300,
  "weight_decay": 0.01
 },
 "variant": "default",
 "vocab_size": 675
}